        <mxCell id="edge_cok_serenity" value="taxi 143km／雨天4〜5h" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D32;strokeWidth=4;endArrow=block;" edge="1" parent="1" source="cok" target="serenity"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_cok_aluva" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#42A5F5;endArrow=block;" edge="1" parent="1" source="cok" target="aluva"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_aluva_munnar" value="bus／迂回案" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9E9E9E;dashed=1;endArrow=block;" edge="1" parent="1" source="aluva" target="munnar"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_munnar_serenity" value="約82km／2.5〜3.5h" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9E9E9E;dashed=1;endArrow=block;" edge="1" parent="1" source="munnar" target="serenity"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_serenity_kumily" value="taxi 約0.5h" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2E7D32;strokeWidth=3;endArrow=block;" edge="1" parent="1" source="serenity" target="kumily"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_kumily_periyar" value="近接" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#E69138;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="kumily" target="periyar"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_kumily_cnn" value="8/10 夜行bus 9h45〜12h20／₹583〜" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#E65100;strokeWidth=4;dashed=1;endArrow=block;" edge="1" parent="1" source="kumily" target="cnn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_cnn_hub" value="taxi 3〜4h（推奨）／bus乗継可" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#E65100;strokeWidth=3;endArrow=block;" edge="1" parent="1" source="cnn" target="kakkabe_hub"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_hub_honey" value="宿4WD" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#E65100;strokeWidth=3;endArrow=block;" edge="1" parent="1" source="kakkabe_hub" target="honey"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_honey_ixe" value="8/15 朝下山＋one-way taxi" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#E65100;strokeWidth=4;endArrow=block;" edge="1" parent="1" source="honey" target="ixe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_ixe_bom" value="8/15 flight（便の販売を要確認）" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1976D2;strokeWidth=3;endArrow=block;" edge="1" parent="1" source="ixe" target="bom"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_cnn_talapoya" value="bus/taxi" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#E69138;dashed=1;endArrow=block;" edge="1" parent="1" source="cnn" target="talapoya"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_talapoya_fringe" value="宿van" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#E69138;dashed=1;endArrow=block;" edge="1" parent="1" source="talapoya" target="fringe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_honey_madikeri" value="約38km" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9E9E9E;dashed=1;endArrow=none;" edge="1" parent="1" source="honey" target="madikeri"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_serenity_iiser" value="南部案：車 約203km／雨天5〜6h" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6A1B9A;strokeWidth=3;dashed=1;endArrow=block;" edge="1" parent="1" source="serenity" target="iiser"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_iiser_trv" value="taxi/bus 1.5〜2h" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6A1B9A;strokeWidth=3;endArrow=block;" edge="1" parent="1" source="iiser" target="trv"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_trv_bom" value="8/15推奨 flight" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1976D2;strokeWidth=3;endArrow=block;" edge="1" parent="1" source="trv" target="bom"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="decision_title" value="&lt;b&gt;結論：目的別の最適ルート&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474F;fontColor=#ffffff;strokeColor=#37474F;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="1280" y="105" width="590" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="route1" value="&lt;b&gt;① 対象種を見られる確率を最大化（本命）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1B5E20&quot;&gt;BOM → COK → Serenity 2夜 → 夜行bus → Honey 4夜 → IXE → BOM&lt;/font&gt;&lt;br&gt;&lt;br&gt;独立した有望地点で合計6夜。Honeyは天候不良を4夜で吸収でき、持込UVを長時間使える可能性がある。&lt;br&gt;&lt;b&gt;ただし採用条件：Honey Valley自身が空室・ownerのUV許可・4WD時刻を文章で確約。未確約のまま予約しない。&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=3;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1280" y="175" width="590" height="205" as="geometry"/>
        </mxCell>
        <mxCell id="route2" value="&lt;b&gt;② 移動の堅牢性＋8月の直接記録（南部代替）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6A1B9A&quot;&gt;BOM → COK → Serenity 2夜 → Periyar 2夜 → IISER/Vithura → TRV → BOM&lt;/font&gt;&lt;br&gt;&lt;br&gt;長距離夜行と州境越えがなく、IISERは8月11日のexact recordが最強。ただし大学で自由観察は不可。&lt;br&gt;&lt;b&gt;採用条件：学内host、来訪登録、19:00〜21:30の同行を最低1夜、できれば2夜確定。&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1280" y="400" width="590" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="route3" value="&lt;b&gt;③ どちらも未確定なら、予約可能性を優先&lt;/b&gt;&lt;br&gt;Serenity 2夜 → Periyar公式night walk → 緑の多い私有宿 → TRV&lt;br&gt;&lt;br&gt;対象確率は①②より下がるが、合法・移動・雨天時の成立性は高い。Fringe Fordは「灯火実施の保険」だが、対象種目的だけで大きく北上する根拠は現在弱い。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1280" y="610" width="590" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="gate" value="&lt;b&gt;8月2日夜の決定ゲート&lt;/b&gt;&lt;br&gt;1. Serenity：部屋＋8/8・9訪問を確定（UV不可でも既設CFLで採用）&lt;br&gt;2. Honey：6条件が全てYES → ルート①&lt;br&gt;3. HoneyがNO／曖昧、IISER hostがYES → ルート②&lt;br&gt;4. 両方NO → ルート③&lt;br&gt;&lt;br&gt;&lt;b&gt;両方YESなら？&lt;/b&gt; 今回の最優先がOdontolabis遭遇なので、4夜の自由度があるHoneyを選ぶ。IISERが2夜の正式同行を確約し、Honeyの灯火時間が短い場合だけ南部へ逆転。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1280" y="795" width="590" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="why" value="&lt;b&gt;判断の要点&lt;/b&gt;&lt;br&gt;・Serenityは「記録・既設灯・owner・近隣宿」が揃う唯一の固定軸。&lt;br&gt;・Honeyは許可後に強い。今はnaturalistの推測ではなく宿ownerの回答待ち。&lt;br&gt;・IISERは記録最強でも、hostなしなら実行確度0。&lt;br&gt;・Fringeは観察体制最強でも、Odontolabis根拠が弱い。&lt;br&gt;・Munnarは地名単位の期待値で、具体的な庭・灯・ownerが未設定。&lt;br&gt;・自走レンタカーの都市間乗捨ては未検証。片道taxi＋bus＋宿車を前提にする。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#607D8B;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1035" width="590" height="200" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
