        <mxCell id="honey" value="&lt;b&gt;Honey Valley / Kakkabe&lt;/b&gt;&lt;br&gt;Ashwin：Odontolabis実見・灯火飛来経験&lt;br&gt;公開記録は12月の損傷個体／Naladiは10月&lt;br&gt;&lt;b&gt;根4　許2→5　夜4　交2&lt;/b&gt;&lt;br&gt;Suresh・Kodagu naturalistは窓口。宿ownerの文章回答が必要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="390" y="335" width="390" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="kakkabe_hub" value="&lt;b&gt;公共交通の接続鎖&lt;/b&gt;&lt;br&gt;Kannur → Iritty → Virajpet → Kakkabe&lt;br&gt;最後は宿指定地点から4WD&lt;br&gt;夜行直後・機材ありならKannurから片道taxi推奨" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#42A5F5;fontSize=12;align=left;spacingLeft=9;" vertex="1" parent="1">
