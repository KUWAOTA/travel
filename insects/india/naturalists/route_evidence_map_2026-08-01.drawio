        <mxCell id="periyar" value="&lt;b&gt;Periyar / Thekkady&lt;/b&gt;&lt;br&gt;Forest Dept公式night walk&lt;br&gt;合法・安全・近いがUV幕でなく対象記録も弱め&lt;br&gt;&lt;b&gt;根2　許5　夜2　交5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE5CD;strokeColor=#E69138;fontSize=13;align=left;spacingLeft=9;" vertex="1" parent="1">
          <mxGeometry x="110" y="980" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="iiser" value="&lt;b&gt;IISER Thiruvananthapuram / Vithura（大学）&lt;/b&gt;&lt;br&gt;2025-08-11：O. versicolor＋P. giraffa／5月にもO. versicolor&lt;br&gt;Parth・Ananya・Rushikeshへhost依頼対象&lt;br&gt;&lt;b&gt;根5　許1→5　夜1〜2　交4&lt;/b&gt;&lt;br&gt;host＋正式登録なしでは採用不可。既存灯を19:00〜21:30想定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="505" y="1030" width="455" height="130" as="geometry"/>
        </mxCell>
