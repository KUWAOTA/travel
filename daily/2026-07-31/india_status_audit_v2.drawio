<mxfile host="app.diagrams.net" modified="2026-07-31T22:34:32+09:00" agent="Codex" version="24.7.17" type="device">
  <diagram id="places" name="行先の認識">
    <mxGraphModel dx="1700" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1510" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="インド昆虫観察：行先ごとの事実確認（計画決定前）" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1740" height="40" as="geometry"/></mxCell>
        <mxCell id="legend" value="青＝対象昆虫の記録根拠あり　緑＝現地の受入・観察方法まで確認　黄＝一部確認　赤＝実行条件なし　灰＝参考候補" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1740" height="36" as="geometry"/></mxCell>
        <mxCell id="h1" value="行先" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f4e78;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="260" height="45" as="geometry"/></mxCell>
        <mxCell id="h2" value="観察記録・根拠" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f4e78;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="280" y="120" width="430" height="45" as="geometry"/></mxCell>
        <mxCell id="h3" value="人・受入・現場条件" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f4e78;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="710" y="120" width="520" height="45" as="geometry"/></mxCell>
        <mxCell id="h4" value="現時点の正しい認識" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f4e78;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1230" y="120" width="530" height="45" as="geometry"/></mxCell>

        <mxCell id="d1" value="&lt;b&gt;Serenity Garden&lt;/b&gt;&lt;br&gt;Chakkuppallam / Thekkady周辺" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="165" width="260" height="115" as="geometry"/></mxCell>
        <mxCell id="r1" value="Seema氏のiNaturalistにクワガタ等の実観察記録。白壁＋常時点灯CFLに、同氏が観察した虫の多くが飛来。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="280" y="165" width="430" height="115" as="geometry"/></mxCell>
        <mxCell id="g1" value="Seema Merchant氏が訪問・観察を明確に歓迎。8/10までは本人滞在。以後も約400m先のMisty ViewsのAnand氏が同行可能。連絡先と地図あり。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="710" y="165" width="520" height="115" as="geometry"/></mxCell>
        <mxCell id="a1" value="&lt;b&gt;記録・既設灯・私有地受入・不在時の同行者まで確認済み。&lt;/b&gt;&lt;br&gt;ただし持込UV/HIDの使用、宿泊予約、訪問日時は未確認。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1230" y="165" width="530" height="115" as="geometry"/></mxCell>

        <mxCell id="d2" value="&lt;b&gt;IISER Thiruvananthapuram&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="280" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="r2" value="ユーザー確認では対象の実観察記録と強い街灯誘引実績あり。保存資料には種名・観察ID・記録者が未収録。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="280" y="280" width="430" height="100" as="geometry"/></mxCell>
        <mxCell id="g2" value="連絡中の教員・学生・記録者なし。正式hostなし。一般guestは事前host申請が前提で、夜間観察許可は未取得。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="710" y="280" width="520" height="100" as="geometry"/></mxCell>
        <mxCell id="a2" value="&lt;b&gt;生物学的根拠は強いが、実行可能性は未成立。&lt;/b&gt;&lt;br&gt;Gardenと違い「行って観察できる」許可はまだない。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1230" y="280" width="530" height="100" as="geometry"/></mxCell>

        <mxCell id="d3" value="&lt;b&gt;Honey Valley / Yevakapadi&lt;/b&gt;&lt;br&gt;Kakkabe / Naladi / Tadiandamol" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="r3" value="Ashwin氏がHoney ValleyでOdontolabisを実見。周辺・同標高でProsopocoilusも実見。iNaturalistに正確な日付・位置。8月はモンスーンで機会あり。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="280" y="380" width="430" height="120" as="geometry"/></mxCell>
        <mxCell id="g3" value="Suresh氏が窓口、2934氏が助言・別naturalist手配可能。Ashwin氏はプロガイドではなく、Honey同行を申し出てはいない。所有者による持込灯火の明示許可・予約は未確認。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="710" y="380" width="520" height="120" as="geometry"/></mxCell>
        <mxCell id="a3" value="&lt;b&gt;対象記録とAshwin氏の具体的推薦は強い。&lt;/b&gt;&lt;br&gt;ただし出現は「毎モンスーンの数日」で予測困難。UV/HID場所・許可・宿・ガイド日程が未成立。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1230" y="380" width="530" height="120" as="geometry"/></mxCell>

        <mxCell id="d4" value="&lt;b&gt;Fringe Ford&lt;/b&gt;&lt;br&gt;Wayanad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="260" height="105" as="geometry"/></mxCell>
        <mxCell id="r4" value="施設で対象クワガタの確実な記録なし。Ahmed氏は大学関係者から生息情報を得ており、モンスーン最盛期と説明。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="280" y="500" width="430" height="105" as="geometry"/></mxCell>
        <mxCell id="g4" value="Santosh＝予約窓口、Ahmed＝owner、Shaji＝20年以上の現地naturalist。自前の白幕・UV使用を歓迎、Shaji同行は追加料金なし。3泊推奨。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="710" y="500" width="520" height="105" as="geometry"/></mxCell>
        <mxCell id="a4" value="&lt;b&gt;運用準備は最も明確だが、対象記録はGarden/Honey/IISERより弱い。&lt;/b&gt;&lt;br&gt;最終料金・食事・空室・予約確定は未了。MunnarではなくWayanad。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1230" y="500" width="530" height="105" as="geometry"/></mxCell>

        <mxCell id="d5" value="&lt;b&gt;Nadugani / Devala / Gudalur&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="605" width="260" height="95" as="geometry"/></mxCell>
        <mxCell id="r5" value="BE-KUWA記事・標本ラベル・Lower Naduganiの2022年8月情報など、産地根拠あり。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="280" y="605" width="430" height="95" as="geometry"/></mxCell>
        <mxCell id="g5" value="現在つながっている現地協力者・宿・合法な夜間観察場所なし。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="710" y="605" width="520" height="95" as="geometry"/></mxCell>
        <mxCell id="a5" value="産地としては有力だが、今回の旅行で実行できる地点にはまだなっていない。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1230" y="605" width="530" height="95" as="geometry"/></mxCell>

        <mxCell id="d6" value="&lt;b&gt;Mudigere / Chikmagalur&lt;/b&gt;&lt;br&gt;Kadumane Estate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="r6" value="SCARABS資料にO. burmeisteri幼虫・7月成虫、P. giraffa街灯記録。Ashwin氏のKadumane記録もある。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="280" y="700" width="430" height="100" as="geometry"/></mxCell>
        <mxCell id="g6" value="Ashwin氏はBangalore周辺なら無償案内を申し出たが、対象種はBangaloreでは期待薄と説明。ここへの同行・私有地許可は未確認。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="710" y="700" width="520" height="100" as="geometry"/></mxCell>
        <mxCell id="a6" value="記録根拠はあるが実行条件なし。Ashwin氏の「案内可能」をこの地点の確定ガイドと解釈しない。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1230" y="700" width="530" height="100" as="geometry"/></mxCell>

        <mxCell id="d7" value="&lt;b&gt;Munnar / Idukki / Udumbanchola&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="r7" value="O. burmeisteri・O. delessertiの複数の現代記録。Camp Woody等の施設名付き記録もある。Serenity Gardenも地理的にはIdukki南部。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="280" y="800" width="430" height="100" as="geometry"/></mxCell>
        <mxCell id="g7" value="Munnar側の確定ガイド・施設許可なし。Paul氏の保存済み本文は別資料にあるが、今回追加されたpaul.txtは0バイト。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="710" y="800" width="520" height="100" as="geometry"/></mxCell>
        <mxCell id="a7" value="地域記録は強い。今回新たに確定した受入先はSerenity Gardenであり、Munnar一般を許可済みとは扱わない。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1230" y="800" width="530" height="100" as="geometry"/></mxCell>

        <mxCell id="d8" value="&lt;b&gt;Kodaikanal / Perumalmalai&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="900" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="r8" value="O. delesserti、H. davisoni、Dorcus rugosus等の記録。Ashwin氏も有望地域として列挙。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="280" y="900" width="430" height="90" as="geometry"/></mxCell>
        <mxCell id="g8" value="連絡中のguide・宿・夜間許可なし。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="710" y="900" width="520" height="90" as="geometry"/></mxCell>
        <mxCell id="a8" value="生物候補。今回の行程へ入れるには現地受入先が必要。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1230" y="900" width="530" height="90" as="geometry"/></mxCell>

        <mxCell id="d9" value="&lt;b&gt;Kanniyakumari Wildlife Sanctuary&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="990" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="r9" value="Paul氏がForest Department許可下のmoth screeningで撮影した実績。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="280" y="990" width="430" height="90" as="geometry"/></mxCell>
        <mxCell id="g9" value="Paul氏は経験者・助言者だが、今回の同行・紹介・許可申請は未確定。追加paul.txtは空。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="710" y="990" width="520" height="90" as="geometry"/></mxCell>
        <mxCell id="a9" value="許可付き観察なら強い候補だが、現在は過去実績だけ。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1230" y="990" width="530" height="90" as="geometry"/></mxCell>

        <mxCell id="d10" value="&lt;b&gt;Periyar / Parambikulam / Silent Valley&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="1080" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="r10" value="Paul氏が公式night walkのある一般候補として示した地域。対象種の特定地点記録は資料上未確認。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="280" y="1080" width="430" height="90" as="geometry"/></mxCell>
        <mxCell id="g10" value="予約済みguideなし。公式walk参加と独自UV/HID設置は別で、後者の許可なし。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="710" y="1080" width="520" height="90" as="geometry"/></mxCell>
        <mxCell id="a10" value="一般自然観察の候補。現状ではクワガタ灯火の確定先ではない。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1230" y="1080" width="530" height="90" as="geometry"/></mxCell>

        <mxCell id="d11" value="&lt;b&gt;Magnolia Resort / Meriyanda&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="1170" width="260" height="85" as="geometry"/></mxCell>
        <mxCell id="r11" value="2934氏の環境推薦。対象種の直接記録は未確認。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="280" y="1170" width="430" height="85" as="geometry"/></mxCell>
        <mxCell id="g11" value="施設との連絡・許可・予約なし。2934氏は別naturalist手配の相談が可能。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="710" y="1170" width="520" height="85" as="geometry"/></mxCell>
        <mxCell id="a11" value="Honey Valleyが成立しない場合の周辺代替候補。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1230" y="1170" width="530" height="85" as="geometry"/></mxCell>

        <mxCell id="d12" value="&lt;b&gt;Mountain Shadows / Blue Ginger / Porcupine Castle&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="1255" width="260" height="95" as="geometry"/></mxCell>
        <mxCell id="r12" value="施設名付きiNaturalist記録あり。Mountain Shadowsは2026-07-04 O. delesserti記録。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="280" y="1255" width="430" height="95" as="geometry"/></mxCell>
        <mxCell id="g12" value="現在つながっている人なし。施設への照会・予約なし。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="710" y="1255" width="520" height="95" as="geometry"/></mxCell>
        <mxCell id="a12" value="記録施設へ直接短文照会する価値はあるが、現時点では未成立。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1230" y="1255" width="530" height="95" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="people" name="連絡先の認識">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="連絡先・ガイドについて、今そろっている認識" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1640" height="40" as="geometry"/></mxCell>
        <mxCell id="n1" value="&lt;b&gt;Seema Merchant&lt;/b&gt;&lt;br&gt;Serenity Garden owner&lt;br&gt;8/10まで現地&lt;br&gt;訪問と既設CFLでの観察を明確に歓迎" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="310" height="125" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;b&gt;Anand&lt;/b&gt;&lt;br&gt;Misty Views運営・英語可&lt;br&gt;Gardenから約400m&lt;br&gt;Seema氏不在時もGardenへ同行可能" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="310" height="125" as="geometry"/></mxCell>
        <mxCell id="e12" value="不在時の代替" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="n3" value="&lt;b&gt;Ashwin (ashwinv)&lt;/b&gt;&lt;br&gt;Odontolabisの実見者&lt;br&gt;Honey Valleyを具体的に推薦&lt;br&gt;プロガイドではない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="310" height="130" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;Ashwin氏の案内申し出&lt;/b&gt;&lt;br&gt;Bangaloreに来るなら無償で昆虫等を案内可能&lt;br&gt;一方、Odontolabis / HexarthriusはBangaloreで期待薄" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="460" y="310" width="380" height="130" as="geometry"/></mxCell>
        <mxCell id="e34" value="範囲を混同しない" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;Honeyで未回答の質問&lt;/b&gt;&lt;br&gt;本人が灯火した正確な土地・施設&lt;br&gt;HIDを森林斜面へ向けられる場所&lt;br&gt;所有者許可の取り方" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="930" y="310" width="350" height="130" as="geometry"/></mxCell>
        <mxCell id="e45" value="返信なし" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="n6" value="&lt;b&gt;2934氏&lt;/b&gt;&lt;br&gt;Suresh氏からの紹介&lt;br&gt;助言・別naturalist手配は可能&lt;br&gt;本人の現場同行は未確定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="525" width="310" height="125" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;Suresh&lt;/b&gt;&lt;br&gt;Honey Valley側の窓口・紹介者&lt;br&gt;owner本人による持込UV/HID許可、予約、guide日は未確定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="460" y="525" width="350" height="125" as="geometry"/></mxCell>

        <mxCell id="n8" value="&lt;b&gt;Fringe Ford&lt;/b&gt;&lt;br&gt;Santosh＝予約窓口&lt;br&gt;Ahmed＝owner&lt;br&gt;Shaji＝現地naturalist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="930" y="525" width="310" height="125" as="geometry"/></mxCell>
        <mxCell id="n9" value="自前UV・白幕歓迎／Shaji同行可&lt;br&gt;ただし対象種の施設内確実記録なし&lt;br&gt;料金・空室・予約は最終未確定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1320" y="525" width="310" height="125" as="geometry"/></mxCell>
        <mxCell id="e89" value="運用は具体的" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="n10" value="&lt;b&gt;Paul Mathi&lt;/b&gt;&lt;br&gt;Kanniyakumariで許可付きmoth screening経験&lt;br&gt;助言者であり、確定guideではない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="745" width="340" height="120" as="geometry"/></mxCell>
        <mxCell id="n11" value="&lt;b&gt;今回の paul.txt&lt;/b&gt;&lt;br&gt;ファイルサイズ 0 byte&lt;br&gt;追加情報を読み取れないため、Paul氏の認識は更新保留" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="490" y="745" width="360" height="120" as="geometry"/></mxCell>
        <mxCell id="e1011" value="要再保存" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="bottom" value="&lt;b&gt;この資料で確定するのは事実関係だけ&lt;/b&gt;&lt;br&gt;Gardenは「記録＋既設灯＋受入＋不在時同行」まで成立。IISERは「記録＋街灯」まで。Honeyは「実見＋具体推薦」まで。Fringe Fordは「現場運用」まで。ここから先の優先順位・経路・車は次の段階で決める。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="930" y="745" width="700" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
