        <mxCell id="p2" value="一般guestは原則5～22時・事前host申請&lt;br&gt;夜間観察許可は未取得" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="930" y="265" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="a2" value="記録者を特定→host依頼→記録街灯を18～22時に案内可能か確認&lt;br&gt;許可前に旅程の主軸とは断定不可" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1260" y="265" width="350" height="100" as="geometry"/></mxCell>

        <mxCell id="d3" value="&lt;b&gt;Honey Valley / Yevakapadi&lt;br&gt;Kakkabe / Naladi / Tadiandamol&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="365" width="240" height="115" as="geometry"/></mxCell>
        <mxCell id="r3" value="Honey Valley・Yevakapadi・NaladiにiNaturalist記録&lt;br&gt;Yevakapadiは8月のO. burmeisteri記録あり&lt;br&gt;ただし頻度は不明" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="260" y="365" width="350" height="115" as="geometry"/></mxCell>
        <mxCell id="g3" value="Suresh：Honey Valley側の窓口&lt;br&gt;2934さん：助言・別naturalist手配可、自身の同行は未定&lt;br&gt;Ashwin：実見者らしいが実返信全文なし" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="610" y="365" width="320" height="115" as="geometry"/></mxCell>
        <mxCell id="p3" value="2934さんはownerがUVを許す見込みと回答&lt;br&gt;Suresh本人の明示許可・部屋予約・ガイド日は未確定" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="930" y="365" width="330" height="115" as="geometry"/></mxCell>
        <mxCell id="a3" value="有望だが「確定本命」ではない&lt;br&gt;Sureshの許可＋空室、Ashwin/紹介ガイドの具体日を取る&lt;br&gt;Tadiandamol山頂は別の夜間地点ではない" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1260" y="365" width="350" height="115" as="geometry"/></mxCell>

        <mxCell id="d4" value="&lt;b&gt;Fringe Ford&lt;/b&gt;&lt;br&gt;Wayanad（Munnarではない）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="240" height="115" as="geometry"/></mxCell>
        <mxCell id="r4" value="施設内のstag beetle確実記録なし&lt;br&gt;大学調査者から「いる」と聞いた程度&lt;br&gt;Wayanad地域には直近O. delesserti記録あり" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="260" y="480" width="350" height="115" as="geometry"/></mxCell>
        <mxCell id="g4" value="Santosh：予約窓口&lt;br&gt;Ahmed：owner&lt;br&gt;Shaji：20年以上のin-house naturalist、支援可" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="610" y="480" width="320" height="115" as="geometry"/></mxCell>
        <mxCell id="p4" value="自前機材持込・Shaji支援は明示的に歓迎&lt;br&gt;水銀灯なし&lt;br&gt;空室は7/24時点、料金・食事・最終予約は未確定" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="930" y="480" width="330" height="115" as="geometry"/></mxCell>
        <mxCell id="a4" value="&lt;b&gt;実行性は最も高い／対象種根拠は弱い&lt;/b&gt;&lt;br&gt;生物学的本命ではなく、雨天込みの確実な観察拠点" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1260" y="480" width="350" height="115" as="geometry"/></mxCell>

