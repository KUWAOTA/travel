  <diagram id="decision" name="誤りと意思決定">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t2" value="何が間違っていたか／どう決めるか" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1500" height="40" as="geometry"/></mxCell>

        <mxCell id="e1" value="&lt;b&gt;誤り1&lt;/b&gt;&lt;br&gt;garden・大学を、名称・所在地・種・記録URL不明のまま1位/2位と採点した" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="e2" value="&lt;b&gt;誤り2&lt;/b&gt;&lt;br&gt;「実記録がある」と「訪問・夜間観察ができる」を同じものとして扱った" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="200" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="e3" value="&lt;b&gt;誤り3&lt;/b&gt;&lt;br&gt;Ashwinの案内先・日付が未確定なのにHoney Valley案内のように寄せた" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="310" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="e4" value="&lt;b&gt;誤り4&lt;/b&gt;&lt;br&gt;Fringe FordをMunnar文脈で扱った。実際はWayanad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="e5" value="&lt;b&gt;誤り5&lt;/b&gt;&lt;br&gt;根拠のない95点/92点や8/2期限を作り、確度が高いように見せた" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="530" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="e6" value="&lt;b&gt;誤り6&lt;/b&gt;&lt;br&gt;garden所在地不明なのに8/8～9訪問・NMI/CNNルートを先に置いた" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="640" width="440" height="90" as="geometry"/></mxCell>

        <mxCell id="s0" value="&lt;b&gt;最初に埋める4項目&lt;/b&gt;&lt;br&gt;gardenの名称・所在地・対象種/記録URL・owner/manager連絡先&lt;br&gt;大学の対象種/記録者・host候補" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="470" height="120" as="geometry"/></mxCell>
        <mxCell id="s1" value="garden：夜間入場と案内が確定？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="620" y="260" width="350" height="120" as="geometry"/></mxCell>
        <mxCell id="s2" value="大学：正式host＋18～22時観察が確定？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="620" y="440" width="350" height="120" as="geometry"/></mxCell>
        <mxCell id="s3" value="確認できた実記録地点を旅程の核にする&lt;br&gt;2～3夜反復" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1100" y="290" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="s4" value="未確認なら、実施体制があるFringe Ford&lt;br&gt;またはSuresh許可＋guide日が取れたHoney Valley" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1100" y="490" width="380" height="110" as="geometry"/></mxCell>
        <mxCell id="s5" value="Nadugani / Mudigereは&lt;br&gt;現地協力者＋合法な夜間場所が確定した時だけ差し替え" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="670" width="380" height="100" as="geometry"/></mxCell>

