                <mxCell id="reasonTitle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=15;align=center;" value="転職理由と応募理由" vertex="1">
                    <mxGeometry height="42" width="500" x="520" y="1650" as="geometry"/>
                </mxCell>
                <mxCell id="lifeReason" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacing=8;" value="転職の直接理由&#xa;&#xa;海外、特にベトナムで長く暮らし、働きたい。未知の環境で生活し、予想外の出来事も含めて経験したい。現職では実現できない。" vertex="1">
                    <mxGeometry height="130" width="350" x="160" y="1730" as="geometry"/>
                </mxCell>
                <mxCell id="careerReason" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8;" value="開発・育成を続ける理由&#xa;&#xa;壊れる／壊れにくいシステムの差を、設計知識で理解・改善することが面白い。自分が身につけた知識を共有し、相手が成長することに喜びを感じる。" vertex="1">
                    <mxGeometry height="130" width="380" x="600" y="1730" as="geometry"/>
                </mxCell>
                <mxCell id="applicationReason" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacing=8;fontStyle=1;" value="ラクス求人を選ぶ理由&#xa;&#xa;海外長期勤務&#xa;× Web開発経験の継続&#xa;× 異なる背景のメンバーへのレビュー・育成&#xa;× 現地側の提案を尊重するワンチーム開発&#xa;× 国内で製品を理解してから赴任&#xa;&#xa;結論：生活上の海外志向と、知識共有・相互学習という職業上の志向が交差する。" vertex="1">
                    <mxGeometry height="165" width="430" x="1070" y="1710" as="geometry"/>
                </mxCell>
                <mxCell id="eLifeApplication" edge="1" parent="1" source="lifeReason" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;" target="applicationReason">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eCareerApplication" edge="1" parent="1" source="careerReason" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;" target="applicationReason">
