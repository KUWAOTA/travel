<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1500" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="title" value="志望動機の収束図：本音・経験・差分・求人を一本につなぐ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F4E78;fontColor=#FFFFFF;fontSize=21;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="25" width="1330" height="55" as="geometry"/></mxCell>
    <mxCell id="life" value="本音の転職理由&lt;br&gt;&lt;br&gt;ベトナムで長く暮らし、働きたい&lt;br&gt;未知の環境へ挑戦したい&lt;br&gt;&lt;br&gt;現職では実現できない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="45" y="120" width="300" height="170" as="geometry"/></mxCell>
    <mxCell id="value" value="仕事で得たい価値&lt;br&gt;&lt;br&gt;設計知識で壊れる理由を理解・改善する&lt;br&gt;知識を共有し、相手が判断できるようになる&lt;br&gt;異なる考え方から自分も学ぶ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="380" y="120" width="300" height="170" as="geometry"/></mxCell>
    <mxCell id="evidence" value="使える経験&lt;br&gt;&lt;br&gt;Web開発 約3年9か月&lt;br&gt;設計・実装・テスト・保守&lt;br&gt;新人1名へ約25回レビュー&lt;br&gt;英語での技術協働 約2週間" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#5B9BD5;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="715" y="120" width="300" height="170" as="geometry"/></mxCell>
    <mxCell id="strength" value="強み・適性&lt;br&gt;&lt;br&gt;未知の環境への好奇心&lt;br&gt;情報を集め、試して進める&lt;br&gt;相手に合わせて図や表現を変える&lt;br&gt;&lt;br&gt;※技術力そのものを強みの中心にしない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="1050" y="120" width="300" height="170" as="geometry"/></mxCell>
    <mxCell id="axis" value="目指す働き方&lt;br&gt;&lt;br&gt;&lt;b&gt;未知の環境で、異なる背景のメンバーと知識を共有し、互いに学びながらチームを強くする。&lt;/b&gt;&lt;br&gt;&lt;br&gt;海外でしかできないとは言わない。本人が挑戦したい異文化環境で、暗黙知を言語化する仕事に取り組む。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=17;spacing=14;" vertex="1" parent="1"><mxGeometry x="250" y="355" width="900" height="150" as="geometry"/></mxCell>
    <mxCell id="gaps" value="現在との差分&lt;br&gt;&lt;br&gt;・システム全体を踏まえた設計レビュー&lt;br&gt;・複数人への継続OJT&lt;br&gt;・チーム改善の測定と定着&lt;br&gt;・長期の異文化協働" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#C55A11;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="100" y="570" width="360" height="180" as="geometry"/></mxCell>
    <mxCell id="path" value="差分を埋めるキャリアプラン&lt;br&gt;&lt;br&gt;国内：製品理解、体系的な設計／MRレビュー、品質基準&lt;br&gt;↓&lt;br&gt;ベトナム：現地リーダーと複数人OJT、相互レビュー&lt;br&gt;↓&lt;br&gt;将来：設計判断とチーム改善を担う技術リード" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4DFEC;strokeColor=#8064A2;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="520" y="550" width="360" height="220" as="geometry"/></mxCell>
    <mxCell id="fit" value="この求人である理由&lt;br&gt;&lt;br&gt;・ベトナム長期勤務&lt;br&gt;・Web開発経験を継続利用&lt;br&gt;・コーチ兼プレイヤー&lt;br&gt;・レビュー／育成／プロセス改善&lt;br&gt;・現地とのワンチーム開発&lt;br&gt;・国内で製品理解後に赴任" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4DFEC;strokeColor=#8064A2;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="940" y="570" width="360" height="180" as="geometry"/></mxCell>
    <mxCell id="give" value="入社時点で提供できること&lt;br&gt;&lt;br&gt;Web機能の設計・実装・テストを自走&lt;br&gt;設計理由を問い、相手の理解を促すレビュー&lt;br&gt;未知の問題で情報収集し、伝え方を変える" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#5B9BD5;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="175" y="835" width="470" height="165" as="geometry"/></mxCell>
    <mxCell id="gain" value="この環境で広げること&lt;br&gt;&lt;br&gt;一人への育成を複数人へ広げる&lt;br&gt;機能単位の判断を製品・チーム単位へ広げる&lt;br&gt;短期の異文化協働を長期の相互学習へ広げる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="755" y="835" width="470" height="165" as="geometry"/></mxCell>
    <mxCell id="motivation" value="志望動機の核&lt;br&gt;&lt;br&gt;&lt;b&gt;ベトナムという未知の環境へ挑戦しながら、Web開発と新人教育の経験を生かし、異なる背景のメンバーと技術知識を共有して、互いに学べるチームづくりに関わりたい。&lt;/b&gt;&lt;br&gt;&lt;br&gt;ラクスには、国内で製品を理解してからベトナムのワンチーム開発へ入り、コーチ兼プレイヤーとして現在の経験を提供しつつ、設計レビュー・複数人育成・長期の異文化協働へ役割を広げる道筋がある。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9D2E9;strokeColor=#7030A0;strokeWidth=3;fontSize=17;spacing=16;" vertex="1" parent="1"><mxGeometry x="180" y="1080" width="1040" height="220" as="geometry"/></mxCell>
    <mxCell id="check" value="面談で確認：①このキャリアプランは求人の実態と合うか　②『教えることで自分も学習を継続する』弱みの表現は安全か　③海外志向と育成志向の接続は自然か　④成長目的に見えすぎず、提供価値が先に伝わるか" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#CC0000;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="180" y="1340" width="1040" height="85" as="geometry"/></mxCell>
