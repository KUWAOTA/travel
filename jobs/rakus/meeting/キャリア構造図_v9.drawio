        <mxCell id="n8" edge="1" parent="1" source="nMotivation" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=6 6;strokeColor=#CC0000;strokeWidth=2;endArrow=open;" target="motivationDraft">
