                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ePhase3" edge="1" parent="1" source="phase3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7030A0;strokeWidth=2;endArrow=block;" target="motivationDraft">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n1" edge="1" parent="1" source="prepIdeal" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=6 6;strokeColor=#CC0000;strokeWidth=2;endArrow=open;" target="gap">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n3" edge="1" parent="1" source="prepReason" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=6 6;strokeColor=#CC0000;strokeWidth=2;endArrow=open;" target="reasonDraft">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n5" edge="1" parent="1" source="prepSW" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=6 6;strokeColor=#CC0000;strokeWidth=2;endArrow=open;" target="weakness">
