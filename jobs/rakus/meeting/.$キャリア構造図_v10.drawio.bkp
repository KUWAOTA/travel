                <mxCell id="eEnvDraft" edge="1" parent="1" source="neededEnvironment" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7030A0;strokeWidth=2;endArrow=block;" target="reasonDraft">
